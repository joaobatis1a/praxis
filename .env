# Committed defaults (no secrets) — used to fill index.html's %VITE_APP_TITLE%/%VITE_APP_DESCRIPTION%
# placeholders at build time. Override VITE_APP_TITLE per-deployment in Vercel env vars when a
# deployment shouldn't show the generic "Demonstração" branding (e.g. the real/functional project).
VITE_APP_TITLE=Praxis: Demonstração
VITE_APP_DESCRIPTION=Gestão de procedimentos, biblioteca de conhecimento e comunicação interna para equipes.
